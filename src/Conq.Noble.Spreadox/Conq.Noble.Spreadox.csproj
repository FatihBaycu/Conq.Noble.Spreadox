<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Conq.Noble.Spreadox</RootNamespace>
    <AssemblyName>Conq.Noble.Spreadox</AssemblyName>
    <AssemblyTitle>Spreadox</AssemblyTitle>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <IsPackable>true</IsPackable>
    <PackageId>Conq.Noble.Spreadox</PackageId>
    <Title>Spreadox</Title>
    <Description>Spreadox is a high-level C# library for Excel (.xlsx) workbooks and A4 PDF chart reports. OpenXml types stay internal. PDF uses in-memory series (not OOXML charts).</Description>
    <PackageTags>spreadox;spreadsheet;xlsx;excel;openxml;chart;streaming;ooxml;pdf</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/FatihBaycu/Conq.Noble.Spreadox/releases</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Conq.Noble.Spreadox.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
  </ItemGroup>

</Project>
